# =============================================================================
# Dish Deck configuration
#
# Copy this file to .env and fill it in:   cp example.env .env
# .env holds secrets. It is ignored by git and Docker builds; never commit it.
#
# The same file is used everywhere:
#   - npm start / npm run dev:server  -> read from ./.env (or ENV_FILE=/path/to/file)
#   - docker compose                  -> env_file: .env
#   - docker run                      -> --env-file .env
#   - Kubernetes                      -> kubectl create secret generic dish-deck-env --from-env-file=.env
# Values set in the real environment override values in the file.
# Write values plainly (KEY=value). Quotes and trailing "# comments" are tolerated,
# but keep comments on their own lines to be safe.
# =============================================================================


# ----------------------------------------------------------------------------
# Required
# ----------------------------------------------------------------------------

# How the Dish Deck server reaches Mealie. Use the internal address when they run
# side by side, e.g. http://mealie:9000 (Docker Compose) or
# http://mealie.mealie.svc.cluster.local:9000 (Kubernetes), or your public URL.
MEALIE_URL=http://mealie:9000

# SECRET. Mealie API token. Create it in Mealie: your profile > API Tokens > Create.
# Recipes and meal plans are created as this user, in this user's household.
MEALIE_TOKEN=


# ----------------------------------------------------------------------------
# Strongly recommended
# ----------------------------------------------------------------------------

# SECRET. Shared passcode the app asks for once per device. Without it, anyone who
# can reach the app can add recipes and meal plans to your Mealie.
# Generate one with:  openssl rand -base64 12
APP_PASSCODE=

# Optional: Cloudflare Access. If the app is behind Cloudflare Access, the app can tell who is signed in:
# emails listed in HOUSEHOLD_EMAILS get everything (no passcode screen); any other email Cloudflare lets in
# is a guest who can only use the Eat out tab. Add guests in Cloudflare (a "guests" Access policy), not here.
# Set all three or none. See README: Sharing Eat out with guests.
# CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# CF_ACCESS_AUD=
# HOUSEHOLD_EMAILS=you@example.com, partner@example.com

# Public Mealie address, used for "Open in Mealie" links in the app.
MEALIE_PUBLIC_URL=

# Your timezone (IANA name), used to decide what "today" is.
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/Chicago


# ----------------------------------------------------------------------------
# Optional: AI recipe ideas (Claude)
# ----------------------------------------------------------------------------

# SECRET. Leave empty to turn AI off; TheMealDB still provides new ideas.
# Get a key at https://console.anthropic.com (Settings > API Keys). Billed per use.
ANTHROPIC_API_KEY=

# Model used for AI ideas. Haiku is the cheapest and fast enough for this.
ANTHROPIC_MODEL=claude-haiku-5-5

# A few words about who you're cooking for; included in AI prompts.
HOUSEHOLD_CONTEXT=a busy family


# ----------------------------------------------------------------------------
# Optional: photos for AI ideas and for saved recipes without one
# ----------------------------------------------------------------------------

# Photos come from Wikipedia (free, no key). AI ideas with no findable photo are
# skipped. Change this only to use another MediaWiki site.
# WIKIPEDIA_API_URL=https://en.wikipedia.org/w/api.php

# SECRET, optional. A free Pexels key (https://www.pexels.com/api/) adds stock food
# photos when Wikipedia has none, so fewer AI ideas get skipped.
PEXELS_API_KEY=


# ----------------------------------------------------------------------------
# Optional: real recipes from trusted sites
# ----------------------------------------------------------------------------

# Folder for the cache (site indexes, recipes, dish lists, photos) and the household's
# skip history. The Docker image uses /data; mount a volume there (the Kubernetes and
# Compose files already do). Without it, everything is forgotten on restart.
# DATA_DIR=/data

# Extra trusted recipe sites, tried before the built-in defaults (see README).
# Format: "Cuisine: site, site; Cuisine: site". New cuisine names are fine.
# RECIPE_SITES=Chinese: madewithlau.com; Jamaican: example-jamaican-recipes.com

# Optional free search fallback for dishes the sites' indexes miss: a self-hosted
# SearXNG with the JSON format enabled (deploy/searxng.yaml sets that up).
# SEARXNG_URL=http://searxng:8080

# Background reader: seconds between requests to any one recipe site (sites are read
# in parallel, so the total is much faster). Reads every recipe page once so filtered
# decks are quick. 0 turns it off. Values under 5 aren't recommended (be kind to sites).
# PREFETCH_SECONDS_PER_SITE=5


# ----------------------------------------------------------------------------
# Optional: "Eat out" tab (find somewhere to eat today)
# ----------------------------------------------------------------------------

# SECRET. Google Maps Platform key with "Places API (New)" enabled. Setting it turns the tab on.
# Google Cloud console > APIs & Services > Credentials > Create credentials > API key, then
# restrict it to Places API (New). Billing must be on, but a household's use normally stays inside
# Google's free monthly allowance (see README: Eat out).
GOOGLE_MAPS_API_KEY=

# Optional browser key for the Map view (Maps JavaScript API). It is sent to the browser, so restrict
# it in Google Cloud to your site's address (HTTP referrers) and to the Maps JavaScript API only.
# Without it the List and Deck views still work.
GOOGLE_MAPS_BROWSER_KEY=


# ----------------------------------------------------------------------------
# Optional: TheMealDB (free recipe database for "New ideas")
# ----------------------------------------------------------------------------

# "1" is TheMealDB's free test key (personal/development use). Supporters get a
# premium key with the full catalog: https://www.themealdb.com/api.php
MEALDB_API_KEY=1


# ----------------------------------------------------------------------------
# Optional: meal planner behavior
# ----------------------------------------------------------------------------

# Days that should get quick dinners (30 min or less). Comma list: mon,tue,wed,thu,fri,sat,sun
BUSY_DAYS=

# First day of the 7-day plan: today | tomorrow | monday | sunday
PLAN_START=today

# Turn dinners that make leftovers (4+ servings) into next-day lunches: true | false
LEFTOVERS=true

# Ingredients never counted as "missing" when checking what's on hand (comma list).
# Leave empty for the default: salt, pepper, water, common oils, sugar, flour, butter.
STAPLES=


# ----------------------------------------------------------------------------
# Optional: server
# ----------------------------------------------------------------------------

# Port the app listens on inside the container/process.
PORT=8080

# Log level: fatal | error | warn | info | debug
LOG_LEVEL=info
