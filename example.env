# =============================================================================
# Dish Deck configuration
#
# Copy this file to .env and fill it in:   cp example.env .env
# .env holds secrets. It is ignored by git and Docker builds; never commit it.
#
# The same file is used everywhere:
#   - npm start / npm run dev:server  -> read from ./.env (or ENV_FILE=/path/to/file)
#   - docker compose                  -> env_file: .env
#   - docker run                      -> --env-file .env
#   - Kubernetes                      -> kubectl create secret generic dish-deck-env --from-env-file=.env
# Values set in the real environment override values in the file.
# =============================================================================


# ----------------------------------------------------------------------------
# Required
# ----------------------------------------------------------------------------

# How the Dish Deck server reaches Mealie. Use the internal address when they run
# side by side, e.g. http://mealie:9000 (Docker Compose) or
# http://mealie.mealie.svc.cluster.local:9000 (Kubernetes), or your public URL.
MEALIE_URL=http://mealie:9000

# SECRET. Mealie API token. Create it in Mealie: your profile > API Tokens > Create.
# Recipes and meal plans are created as this user, in this user's household.
MEALIE_TOKEN=


# ----------------------------------------------------------------------------
# Strongly recommended
# ----------------------------------------------------------------------------

# SECRET. Shared passcode the app asks for once per device. Without it, anyone who
# can reach the app can add recipes and meal plans to your Mealie.
# Generate one with:  openssl rand -base64 12
APP_PASSCODE=

# Public Mealie address, used for "Open in Mealie" links in the app.
MEALIE_PUBLIC_URL=

# Your timezone (IANA name), used to decide what "today" is.
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/Chicago


# ----------------------------------------------------------------------------
# Optional: AI recipe ideas (Claude)
# ----------------------------------------------------------------------------

# SECRET. Leave empty to turn AI off; TheMealDB still provides new ideas.
# Get a key at https://console.anthropic.com (Settings > API Keys). Billed per use.
ANTHROPIC_API_KEY=

# Model used for AI ideas. Haiku is the cheapest and fast enough for this.
ANTHROPIC_MODEL=claude-haiku-5-5

# A few words about who you're cooking for; included in AI prompts.
HOUSEHOLD_CONTEXT=a busy family


# ----------------------------------------------------------------------------
# Optional: TheMealDB (free recipe database for "New ideas")
# ----------------------------------------------------------------------------

# "1" is TheMealDB's free test key (personal/development use). Supporters get a
# premium key with the full catalog: https://www.themealdb.com/api.php
MEALDB_API_KEY=1


# ----------------------------------------------------------------------------
# Optional: meal planner behavior
# ----------------------------------------------------------------------------

# Days that should get quick dinners (30 min or less). Comma list: mon,tue,wed,thu,fri,sat,sun
BUSY_DAYS=

# First day of the 7-day plan: today | tomorrow | monday | sunday
PLAN_START=today

# Turn dinners that make leftovers (4+ servings) into next-day lunches: true | false
LEFTOVERS=true

# Ingredients never counted as "missing" when checking what's on hand (comma list).
# Leave empty for the default: salt, pepper, water, common oils, sugar, flour, butter.
STAPLES=


# ----------------------------------------------------------------------------
# Optional: server
# ----------------------------------------------------------------------------

# Port the app listens on inside the container/process.
PORT=8080

# Log level: fatal | error | warn | info | debug
LOG_LEVEL=info
